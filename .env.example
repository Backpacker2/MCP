# Canvas instantie. MOET https zijn — over http gaat je token leesbaar
# over het netwerk en kan het onderweg worden meegelezen.
CANVAS_BASE_URL=https://jouwschool.instructure.com

# Canvas access token. Behandel dit als een wachtwoord.
# Zet de rechten van je .env bestand op 600:  chmod 600 .env
CANVAS_ACCESS_TOKEN=<CANVAS_ACCESS_TOKEN>

# Write-acties (zoals een Portflow-snapshot inleveren) staan standaard UIT.
# Zet dit alleen tijdelijk op true als je bewust iets wilt inleveren, en
# zet het daarna weer uit. Zie docs/gevaren.md.
# CANVAS_ALLOW_WRITES=false
